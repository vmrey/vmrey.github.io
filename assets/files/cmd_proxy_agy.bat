@echo off
:: 设置编码为 UTF-8，防止中文路径乱码
chcp 65001 >nul

:: ========================================================
:: 【在此处修改你的代理地址和端口】
set "PROXY_URL=http://127.0.0.1:10808"
:: ========================================================

:: 设置临时会话代理
set "http_proxy=%PROXY_URL%"
set "https_proxy=%PROXY_URL%"

:: 获取当前目录
if "%~1"=="" (
    cd /d "%~dp0"
) else (
    cd /d "%~1"
)

:: 打印提示信息
echo ========================================================
echo  已成功启动 CMD 并配置临时代理！
echo  当前代理地址: %PROXY_URL%
echo  当前工作目录: %CD%
echo ========================================================

:: 启动一个新的 cmd 窗口并保持当前环境变量
cmd /k agy --dangerously-skip-permissions